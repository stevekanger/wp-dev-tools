{
  "name": "plugin-with-tests",
  "version": "1.0.0",
  "description": "Plugin with tests.",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest",
    "build": "wp-scripts build",
    "dev": "wp-scripts start",
    "archive:dist": "composer install --no-dev && npm run build && wp-dev-tools archive --type dist && composer install",
    "archive:dev": "wp-dev-tools archive --type dev",
    "copy": "wp-dev-tools copy",
    "create:block": "wp-dev-tools createBlock",
    "docker:shell": "docker exec -it plugin-with-tests-wordpress /bin/bash",
    "docker:extract": "wp-dev-tools dockerExtract --container plugin-with-tests-wordpress"
  },
  "devDependencies": {
    "vitest": "^5.0.2",
    "@stevekanger/wp-dev-tools": "^0.1.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/wordpress__block-editor": "^15.0.6",
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/scripts": "^36.0.0",
    "browser-sync-webpack-plugin": "^2.4.0",
    "dotenv": "^18.0.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "core-js": false,
    "core-js-pure": false
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  }
}
