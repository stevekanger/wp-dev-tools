{
  "name": "johndoe/theme-with-tests",
  "description": "Theme with tests.",
  "license": "GPL-2.0-or-later",
  "autoload-dev": {
    "psr-4": {
      "ThemeWithTests\\Tests\\": "tests/php/"
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wordpress/wordpress-tests-phpunit",
        "version": "7.1.4",
        "source": {
          "url": "https://develop.svn.wordpress.org/tags/7.1.4/tests/",
          "type": "svn",
          "reference": "phpunit/"
        }
      }
    }
  ],
  "scripts": {
    "test": "docker exec -it -w /var/www/html/wp-content/themes/theme-with-tests theme-with-tests-wordpress-test ./vendor/bin/phpunit"
  },
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.34",
    "yoast/phpunit-polyfills": "^4.0",
    "wordpress/wordpress-tests-phpunit": "7.1.4",
    "stevekanger/sk-php-cs-fixers": "^0.1.2"
  }
}
