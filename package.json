{
  "name": "@stevekanger/wp-dev-tools",
  "version": "0.1.7",
  "description": "Development tools for wordpress.",
  "repository": "github:stevekanger/wp-dev-tools",
  "keywords": [
    "wordpress",
    "development",
    "wp",
    "dev",
    "tools"
  ],
  "license": "GPL-2.0-or-later",
  "author": "stevekanger",
  "type": "commonjs",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --watch --import tsx src/index.ts",
    "pack": "npm run build && npm pack --pack-destination ./local",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "wp-dev-tools": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^18.0.4",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
