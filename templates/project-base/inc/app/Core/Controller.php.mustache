<?php

declare(strict_types=1);

namespace {{phpNamespace}}\Core;

defined('ABSPATH') || exit;

/**
 * Base controller class.
 *
 * Your connection to wordpress.
 * Extend this class to create your own controller.
 *
 * @since {{version}}
 */
abstract class Controller {
    /**
     * Construct the controller attributes.
     *
     * @param Container $container The container
     *
     * @since {{version}}
     */
    public function __construct(
        protected Container $container,
    ) {
    }

    /**
     * Called by the Container to instantiate the class.
     *
     * @param Container $container The container
     *
     * @since {{version}}
     */
    abstract public static function factory(Container $container): static;

    /**
     * Register wordpress hooks, ect here.
     *
     * Override this in your extended controller.
     *
     * @since {{version}}
     */
    abstract public function register(): void;
}
