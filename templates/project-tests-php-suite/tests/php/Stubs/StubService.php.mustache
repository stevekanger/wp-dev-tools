class StubService {
    /**
     * Gets the sum of all args.
     *
     * @param int ...$args The numbers you want to sum.
     *
     * @since {{version}}
     */
    public function sum(int ...$args): int {
        $sum = 0;

        for ($i = 0; $i < count($args); ++$i) {
            $sum += $args[$i];
        }

        return $sum;
    }
}
