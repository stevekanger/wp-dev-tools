<?php

declare(strict_types=1);

namespace {{phpNamespace}};

use {{phpNamespace}}\Config\AppConfig;
use {{phpNamespace}}\Controllers\AssetController;
use {{phpNamespace}}\Core\Container;

defined('ABSPATH') || exit;

// Require autoloader
require_once __DIR__ . '/vendor/autoload.php';

// Initialize the app config information.
AppConfig::init(
    version: get_file_data(__DIR__ . '/style.css', ['Version' => 'Version'])['Version'] ?: '{{version}}',
    root_dir: __DIR__,
    root_file: __FILE__,
    title: '{{title}}',
    prefix: '{{prefix}}',
    slug: '{{slug}}',
);

// Create the service container
$container = new Container();

// If you have any services bind them to the container. Example:
// $container->bind(ExampleService::class, ExampleService::create(...));

// Create the app
$app = new App($container);

// Init the app
$app->init();

// Create and register controllers
AssetController::create($container)->register();
