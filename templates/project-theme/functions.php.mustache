<?php

declare(strict_types=1);

namespace {{phpNamespace}};

use {{phpNamespace}}\Config\AppConfig;
use {{phpNamespace}}\Controllers\AssetController;
use {{phpNamespace}}\Core\Container;

defined('ABSPATH') || exit;

// Require autoloader
require_once __DIR__ . '/vendor/autoload.php';

// Initialize the app config information.
AppConfig::init(
    get_file_data(__DIR__ . '/style.css', ['Version' => 'Version'])['Version'] ?: '{{version}}',
    __DIR__,
    __FILE__,
    '{{title}}',
    '{{prefix}}',
    '{{slug}}',
);

// Initialize the service container
$container = new Container();

// If you have any services bind them to the container. Example:
// $container->bind(ExampleService::class, ExampleService::factory(...));

// Initialize the app
$app = (new App($container))->init();

// Register all controllers
$app->register_controllers(
    AssetController::factory(...)
);
