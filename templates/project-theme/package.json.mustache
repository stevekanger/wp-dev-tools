{
  "name": "{{slug}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "core-js": false,
    "core-js-pure": false
  },
  "scripts": {
{{#installTests}}
    "test": "vitest",
{{/installTests}}
    "dev": "wp-scripts start",
    "build": "wp-scripts build",
    "archive:dist": "composer install --no-dev && wp-scripts build && wp-dev-tools archive --type dist && composer install",
    "archive:dev": "wp-dev-tools archive --type dev",
    "docker:shell": "docker exec -it {{slug}}-wordpress /bin/bash",
    "docker:extract": "wp-dev-tools dockerExtract --container {{slug}}-wordpress",
    "copy": "wp-dev-tools copy"
  },
  "devDependencies": {
{{#installTests}}
    "vitest": "^5.0.2",
{{/installTests}}
    "@stevekanger/wp-dev-tools": "^{{devToolsVersion}}",
    "@wordpress/scripts": "^36.0.0",
    "browser-sync-webpack-plugin": "^2.4.0",
    "dotenv": "^18.0.4",
    "typescript": "^6.0.3"
  }
}
